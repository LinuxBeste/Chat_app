#### Server ####
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
API_PREFIX=/api

#### CORS ####
CORS_ORIGIN=*

#### Security ####
JWT_SECRET=change-me-to-a-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

#### Database (PostgreSQL) ####
DATABASE_URL=postgresql://chat:chat@localhost:5432/chat
DB_POOL_MAX=20

#### Redis (optional — omit to run without Redis) ####
# REDIS_URL=redis://localhost:6379

#### Rate Limiting ####
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
IP_RATE_LIMIT_MAX=20
REG_RATE_LIMIT_MAX=5

#### WebSocket ####
WS_HEARTBEAT_INTERVAL=30000
WS_MAX_CONNECTIONS_PER_IP=10

#### Uploads ####
UPLOAD_DIR=data/uploads
MAX_FILE_SIZE=10485760

#### Admin / Owner ####
# OWNER_USER_ID=
# ADMIN_USER_IDS=

#### Logging ####
LOG_LEVEL=info
