    "expo-image-picker": "^16.0.0",
    "expo-secure-store": "^57.0.1",
    "expo-status-bar": "~2.2.0",
    "expo-system-ui": "^57.0.1",
    "i18next": "^24.0.0",
    "lucide-react-native": "^0.400.0",
    "react": "^19.0.0",
