# Backend API URL (required for Android/iOS builds)
# For local development with a server on your machine:
#   Android emulator: http://10.0.2.2:3000
#   Physical device:   http://<your-computer-ip>:3000
# For production: https://your-server.com
EXPO_PUBLIC_API_URL=http://localhost:3000

# Keep React Native's native fetch (supports FormData file parts with {uri, name, type}).
# Without this, Expo SDK 56+ swaps in expo/fetch (WinterCG), which rejects those parts.
EXPO_PUBLIC_USE_RN_FETCH=1
