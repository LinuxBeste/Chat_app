{
  "private": true,
  "scripts": {
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,yaml,yml}\"",
    "lint": "eslint \"server/src/**/*.ts\" \"client/web/src/**/*.{ts,tsx}\"",
    "i18n:sync": "node scripts/i18n-sync.mjs",
    "db:generate": "pnpm --dir server db:generate",
    "db:migrate": "pnpm --dir server db:migrate",
    "db:seed": "pnpm --dir server db:seed"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.5"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1"
  }
}
